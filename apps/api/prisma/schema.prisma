generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LocationType {
  BRANCH_STORE
  BRANCH_WAREHOUSE
  TRUCK
  PERSONNEL
}

enum CustomerType {
  RETAIL
  BUSINESS
}

enum PriceScope {
  GLOBAL
  BRANCH
  TIER
  CUSTOMER_GROUP
  CONTRACT
}

enum PriceFlowMode {
  ANY
  REFILL_EXCHANGE
  NON_REFILL
}

enum PriceListVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ROLLED_BACK
  CANCELLED
}

enum ActorChannel {
  WEB
  MOBILE
  DESKTOP
  SYNC
  API
}

enum InventoryMovementType {
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  REFILL
  RETURN
  LENDING_OUT
  LENDING_RETURN
}

enum TransferMode {
  SUPPLIER_RESTOCK_IN
  SUPPLIER_RESTOCK_OUT
  CREATE
  USED
  CONVERT
  INTER_STORE_TRANSFER
  STORE_TO_WAREHOUSE
  WAREHOUSE_TO_STORE
  GENERAL
}

enum CostingMethod {
  WAC
  STANDARD
  LAST_PURCHASE
  MANUAL_OVERRIDE
}

enum CostAllocationBasis {
  PER_QUANTITY
  PER_WEIGHT
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum PurchaseOrderPulloutReason {
  EXPIRED
  DAMAGED
  WRONG_ITEM
  OVERDELIVERY
  EMPTIES
  OTHER
}

enum NegativeStockPolicy {
  BLOCK_POSTING
  ALLOW_WITH_REVIEW
}

enum CylinderOwnership {
  COMPANY
  CUSTOMER
}

enum CylinderStatus {
  FULL
  EMPTY
  DAMAGED
  JUNKED
  DISPOSED
  LOST
}

enum CylinderEventType {
  ISSUE
  RETURN
  EXCHANGE
  TRANSFER
  REFILL
  DAMAGE
  LOSS
  JUNK
  DISPOSE
  REPLACE
}

enum LpgItemServiceActionType {
  DISPOSE
  REPLACE
  JUNK
}

enum SaleType {
  PICKUP
  DELIVERY
}

enum SaleStatus {
  ACTIVE
  CANCELLED
  VOIDED
}

enum SaleReturnStatus {
  POSTED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  E_WALLET
}

enum CustomerPaymentPurpose {
  SALE_BALANCE
  LENDING_DEPOSIT
}

enum DeliveryStatus {
  CREATED
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  COMPLETE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SyncReviewStatus {
  OPEN
  RESOLVED
}

enum AuditActionLevel {
  INFO
  WARNING
  CRITICAL
}

enum EntitlementStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum EntitlementBranchMode {
  SINGLE
  MULTI
}

enum EntitlementInventoryMode {
  STORE_ONLY
  STORE_WAREHOUSE
}

enum TenancyDatastoreMode {
  SHARED_DB
  DEDICATED_DB
}

enum TenancyMigrationState {
  NONE
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum NfcCardOwnerType {
  USER
}

enum NfcCardStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum NfcCardEventType {
  BIND
  REASSIGN
  DEACTIVATE
  REACTIVATE
  REVOKE
}

enum CardInventoryStatus {
  UNASSIGNED
  ASSIGNED
  INACTIVE
  REVOKED
}

enum CardTagType {
  NFC
  RFID_UID
}

enum CustomerCardStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum CustomerPointsTxnType {
  EARN
  REDEEM
  ADJUST_UP
  ADJUST_DOWN
  EXPIRE
}

enum CustomerPointsSourceType {
  SALE
  REWARD
  MANUAL
  SYSTEM
}

enum RewardType {
  DISCOUNT_FIXED
  DISCOUNT_PERCENT
  FREE_PRODUCT
  FREE_DELIVERY
  FREE_SERVICE
  FREE_REFILL
  VOUCHER
}

enum RewardStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RewardRedemptionStatus {
  RESERVED
  APPLIED
  CANCELLED
  VOIDED
  EXPIRED
}

enum LendingStatus {
  OPEN
  PARTIALLY_RETURNED
  CLOSED
  OVERDUE
  CANCELLED
  FORCE_CLOSED
}

enum LendingReturnCondition {
  GOOD
  DAMAGED
  LOST
}

enum LendingSettlementType {
  NONE
  DEPOSIT_HELD
  CHARGED_TO_CUSTOMER
  WAIVED
  WRITE_OFF
}

model Company {
  id                      String                @id @default(uuid())
  code                    String                @unique
  externalClientId        String?               @unique
  name                    String
  tenantEmail             String?
  currencyCode            String                @default("PHP")
  timezone                String                @default("Asia/Manila")
  subscriptionStatus      EntitlementStatus     @default(ACTIVE)
  entitlementUpdatedAt    DateTime?
  addonEmailFeatures      Boolean               @default(false)
  addonEmailReport        Boolean               @default(false)
  addonEmailCustomerBalance Boolean             @default(false)
  addonSmsAlerts          Boolean               @default(false)
  addonAutoReportDigest   Boolean               @default(false)
  addonCustomPricing      Boolean               @default(false)
  addonCustomerCategory   Boolean               @default(false)
  addonItemPriceCostAudit Boolean               @default(false)
  addonPettyCashAttachments Boolean             @default(false)
  addonShiftSecurityControls Boolean            @default(false)
  addonKiloOverviewChart  Boolean               @default(false)
  addonReceiptAmountPrivacy Boolean             @default(false)
  addonPurchaseOrderSuite Boolean               @default(false)
  addonDeliveryDispatchSuite Boolean            @default(false)
  datastoreMode           TenancyDatastoreMode  @default(SHARED_DB)
  datastoreRef            String?
  datastoreMigrationState TenancyMigrationState @default(NONE)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  branding                  BrandingConfig?
  entitlement               CompanyEntitlement?
  entitlementEvents         CompanyEntitlementEvent[]
  branches                  Branch[]
  locations                 Location[]
  users                     User[]
  personnelRoles            PersonnelRole[]
  personnels                Personnel[]
  roles                     Role[]
  priceRules                PriceRule[]
  priceListVersions         PriceListVersion[]
  priceListVersionRules     PriceListVersionRule[]
  priceListRollbackAudits   PriceListRollbackAudit[]
  customers                 Customer[]
  customerCategories        CustomerCategory[]
  suppliers                 Supplier[]
  products                  Product[]
  productCategories         ProductCategory[]
  productBrands             ProductBrand[]
  cylinderTypes             CylinderType[]
  priceLists                PriceList[]
  expenseCategories         ExpenseCategory[]
  inventoryBalances         InventoryBalance[]
  inventoryLedgers          InventoryLedger[]
  stockTransfers            StockTransfer[]
  purchaseOrders            PurchaseOrder[]
  purchaseOrderLines        PurchaseOrderLine[]
  purchaseOrderReceipts     PurchaseOrderReceipt[]
  purchaseOrderReceiptLines PurchaseOrderReceiptLine[]
  purchaseOrderPullouts     PurchaseOrderPullout[]
  purchaseOrderPulloutLines PurchaseOrderPulloutLine[]
  purchaseOrderAttachments  PurchaseOrderAttachment[]
  purchaseOrderDeliveries   PurchaseOrderDelivery[]
  costingConfig             CostingConfig?
  vcardPointsPolicy         VcardPointsPolicy?
  cylinders                 Cylinder[]
  cylinderEvents            CylinderEvent[]
  lpgItemServiceActions     LpgItemServiceAction[]
  cylinderBalances          CylinderBalance[]
  shifts                    Shift[]
  sales                     Sale[]
  deliveryOrders            DeliveryOrder[]
  pettyCashEntries          PettyCashEntry[]
  pettyCashAttachments      PettyCashAttachment[]
  customerPayments          CustomerPayment[]
  depositLedger             DepositLiabilityLedger[]
  syncCursors               SyncCursor[]
  syncReviews               SyncReview[]
  idempotencyKeys           IdempotencyKey[]
  auditLogs                 AuditLog[]
  databaseBackups           TenantDatabaseBackup[]
  eventSales                EventSales[]
  eventStock                EventStockMovement[]
  eventDelivery             EventDeliveryPerformance[]
  eventBehavior             EventUserBehavior[]
  tenantDatastores          TenantDatastoreRegistry[]
  mobileEnrollmentTokens    MobileEnrollmentToken[]
  nfcCards                  NfcCard[]
  nfcCardEvents             NfcCardEvent[]
  cardInventory             CardInventory[]
  customerCards             CustomerCard[]
  customerPointsLedger      CustomerPointsLedger[]
  redeemableRewards         RedeemableReward[]
  customerRewardRedemptions CustomerRewardRedemption[]
  lendingTransactions       LendingTransaction[]
  lendingLines              LendingLine[]
  lendingReturns            LendingReturn[]
  saleReturns               SaleReturn[]
  itemPriceCostAudits       ItemPriceCostAudit[]
}

model TenantDatastoreRegistry {
  id           String   @id @default(uuid())
  companyId    String
  datastoreRef String
  encryptedUrl String   @db.Text
  iv           String
  authTag      String
  keyVersion   String   @default("v1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, datastoreRef])
  @@index([datastoreRef])
  @@index([companyId, updatedAt])
}

model CompanyEntitlement {
  id               String                   @id @default(uuid())
  companyId        String                   @unique
  externalClientId String
  status           EntitlementStatus        @default(ACTIVE)
  maxBranches      Int                      @default(1)
  branchMode       EntitlementBranchMode    @default(SINGLE)
  inventoryMode    EntitlementInventoryMode @default(STORE_ONLY)
  allowDelivery    Boolean                  @default(false)
  allowTransfers   Boolean                  @default(false)
  allowMobile      Boolean                  @default(true)
  graceUntil       DateTime?
  lastSyncedAt     DateTime                 @default(now())
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  company Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events  CompanyEntitlementEvent[]

  @@index([externalClientId, status])
}

model CompanyEntitlementEvent {
  id              String   @id @default(uuid())
  companyId       String
  entitlementId   String?
  externalEventId String?  @unique
  eventType       String
  source          String   @default("WEBHOOK")
  payload         Json
  createdAt       DateTime @default(now())

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entitlement CompanyEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model BrandingConfig {
  id                   String   @id @default(uuid())
  companyId            String   @unique
  companyName          String
  companyLogo          String?
  logoLight            String?
  logoDark             String?
  receiptLogo          String?
  primaryColor         String   @default("#0B3C5D")
  secondaryColor       String   @default("#328CC1")
  receiptFooterText    String?  @db.Text
  invoiceNumberFormat  String   @default("{BRANCH}-{YYYY}-{SEQ}")
  officialNumberFormat String   @default("OR-{YYYY}-{SEQ}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model VcardPointsPolicy {
  id                    String   @id @default(uuid())
  companyId             String   @unique
  earnPesoPerPoint      Decimal  @default(100) @db.Decimal(12, 2)
  redeemPesoPerPoint    Decimal  @default(1) @db.Decimal(12, 2)
  minSpendForEarn       Decimal  @default(0) @db.Decimal(12, 2)
  maxRedeemPointsPerTxn Int?
  pointsExpiryDays      Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model RedeemableReward {
  id                String       @id @default(uuid())
  companyId         String
  code              String
  name              String
  description       String?      @db.Text
  rewardType        RewardType
  status            RewardStatus @default(DRAFT)
  pointsCost        Int
  productId         String?
  freeQty           Decimal?     @db.Decimal(12, 2)
  discountValue     Decimal?     @db.Decimal(12, 2)
  minSpend          Decimal?     @db.Decimal(12, 2)
  maxDiscountAmount Decimal?     @db.Decimal(12, 2)
  stackable         Boolean      @default(false)
  perCustomerLimit  Int?
  dailyLimit        Int?
  validFrom         DateTime?
  validTo           DateTime?
  metadata          Json?
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  company     Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product?                   @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy   User?                      @relation("RedeemableRewardCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  scopes      RedeemableRewardScope[]
  redemptions CustomerRewardRedemption[]

  @@unique([companyId, code])
  @@index([companyId, status, updatedAt])
  @@index([companyId, rewardType, status, updatedAt])
}

model RedeemableRewardScope {
  id         String   @id @default(uuid())
  rewardId   String
  branchId   String?
  locationId String?
  createdAt  DateTime @default(now())

  reward   RedeemableReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  location Location?        @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([rewardId, branchId, locationId])
  @@index([rewardId, createdAt])
  @@index([branchId, locationId])
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locations              Location[]
  priceLists             PriceList[]
  shifts                 Shift[]
  sales                  Sale[]
  pettyCash              PettyCashEntry[]
  receipts               Receipt[]
  deliveryOrders         DeliveryOrder[]
  customerPayments       CustomerPayment[]
  mobileEnrollmentTokens MobileEnrollmentToken[]
  personnels             Personnel[]
  cardInventory          CardInventory[]
  rewardScopes           RedeemableRewardScope[]
  lendingTransactions    LendingTransaction[]
  saleReturns            SaleReturn[]
  lpgItemServiceActions  LpgItemServiceAction[]
  purchaseOrders         PurchaseOrder[]

  @@unique([companyId, code])
  @@index([companyId, updatedAt])
}

model PersonnelRole {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  personnels Personnel[]

  @@unique([companyId, code])
  @@index([companyId, updatedAt])
}

model Personnel {
  id              String   @id @default(uuid())
  companyId       String
  branchId        String
  code            String
  fullName        String
  personnelRoleId String
  phone           String?
  email           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  role    PersonnelRole @relation(fields: [personnelRoleId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId, branchId, updatedAt])
  @@index([personnelRoleId])
}

model Location {
  id        String       @id @default(uuid())
  companyId String
  branchId  String?
  code      String
  name      String
  type      LocationType
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                 Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  inventoryBalances      InventoryBalance[]
  inventoryLedgers       InventoryLedger[]
  sourceTransfers        StockTransfer[]         @relation("TransferSource")
  destinationTransfers   StockTransfer[]         @relation("TransferDestination")
  cylinders              Cylinder[]
  cylinderEventsFrom     CylinderEvent[]         @relation("CylinderEventFrom")
  cylinderEventsTo       CylinderEvent[]         @relation("CylinderEventTo")
  cylinderBalances       CylinderBalance[]
  sales                  Sale[]
  syncCursors            SyncCursor[]
  suppliers              Supplier[]
  mobileEnrollmentTokens MobileEnrollmentToken[]
  cardInventory          CardInventory[]
  rewardScopes           RedeemableRewardScope[]
  lendingTransactions    LendingTransaction[]
  saleReturns            SaleReturn[]
  lpgItemServiceActions  LpgItemServiceAction[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderReceipts  PurchaseOrderReceipt[]
  purchaseOrderPullouts  PurchaseOrderPullout[]
  purchaseOrderDeliveries PurchaseOrderDelivery[]

  @@unique([companyId, code])
  @@index([companyId, updatedAt])
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String?
  email        String
  fullName     String
  passwordHash String
  mustChangePassword Boolean @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company                       Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles                     UserRole[]
  supervisorPin                 SupervisorPin?
  refreshTokens                 RefreshToken[]
  deviceSessions                DeviceSession[]
  shifts                        Shift[]
  sales                         Sale[]
  deliveryAssignments           DeliveryAssignment[]
  cashierValidatedDeliveryOrders DeliveryOrder[]          @relation("DeliveryOrderCashierValidatedBy")
  actedDeliveryStatusEvents     DeliveryStatusEvent[]     @relation("DeliveryStatusEventActor")
  pettyCashEntries              PettyCashEntry[]
  auditLogs                     AuditLog[]
  createdDatabaseBackups        TenantDatabaseBackup[]      @relation("TenantDatabaseBackupCreatedBy")
  discountOverrides             DiscountOverrideLog[]
  requestedTransfers            StockTransfer[]
  postedCustomerPayments        CustomerPayment[]
  mobileEnrollmentTokens        MobileEnrollmentToken[]    @relation("MobileEnrollmentUser")
  createdMobileEnrollmentTokens MobileEnrollmentToken[]    @relation("MobileEnrollmentCreator")
  ownedNfcCards                 NfcCard[]                  @relation("NfcCardOwner")
  nfcCardEvents                 NfcCardEvent[]             @relation("NfcCardEventActor")
  assignedCustomerCards         CustomerCard[]             @relation("CustomerCardAssignedBy")
  createdCustomerPointsEntries  CustomerPointsLedger[]     @relation("CustomerPointsCreatedBy")
  createdRedeemableRewards      RedeemableReward[]         @relation("RedeemableRewardCreatedBy")
  createdRewardRedemptions      CustomerRewardRedemption[] @relation("CustomerRewardRedemptionCreatedBy")
  createdLendingTransactions    LendingTransaction[]       @relation("LendingCreatedBy")
  approvedLendingTransactions   LendingTransaction[]       @relation("LendingApprovedBy")
  receivedLendingReturns        LendingReturn[]            @relation("LendingReturnReceivedBy")
  cancelledSales                Sale[]                     @relation("SaleCancelledBy")
  voidedSales                   Sale[]                     @relation("SaleVoidedBy")
  createdSaleReturns            SaleReturn[]               @relation("SaleReturnCreatedBy")
  voidedSaleReturns             SaleReturn[]               @relation("SaleReturnVoidedBy")
  createdLpgItemServiceActions  LpgItemServiceAction[]     @relation("LpgItemServiceActionCreatedBy")

  @@unique([companyId, email])
  @@index([companyId, updatedAt])
}

model MobileEnrollmentToken {
  id               String    @id @default(uuid())
  companyId        String
  userId           String
  branchId         String
  locationId       String
  createdByUserId  String?
  tokenHash        String    @unique
  expiresAt        DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  claimedDeviceId  String?
  claimedIp        String?
  claimedUserAgent String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation("MobileEnrollmentUser", fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("MobileEnrollmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, userId, createdAt])
  @@index([companyId, expiresAt, usedAt, revokedAt])
}

model NfcCard {
  id         String           @id @default(uuid())
  companyId  String
  uid        String
  ownerType  NfcCardOwnerType @default(USER)
  ownerId    String
  status     NfcCardStatus    @default(ACTIVE)
  assignedAt DateTime         @default(now())
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User           @relation("NfcCardOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  events  NfcCardEvent[]

  @@unique([companyId, uid])
  @@index([companyId, status, updatedAt])
  @@index([companyId, ownerId, status])
}

model NfcCardEvent {
  id          String           @id @default(uuid())
  companyId   String
  cardId      String
  eventType   NfcCardEventType
  actorUserId String?
  payload     Json?
  createdAt   DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  card    NfcCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actor   User?   @relation("NfcCardEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([cardId, createdAt])
}

model CardInventory {
  id           String              @id @default(uuid())
  companyId    String
  branchId     String?
  locationId   String?
  cardUid      String
  cardNumber   String
  serialNumber String?
  cardUrl      String?
  status       CardInventoryStatus @default(UNASSIGNED)
  tagType      CardTagType         @default(NFC)
  writable     Boolean             @default(false)
  metadata     Json?
  assignedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch            Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  location          Location?                  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customerCards     CustomerCard[]
  pointsLedger      CustomerPointsLedger[]
  rewardRedemptions CustomerRewardRedemption[]

  @@unique([companyId, cardUid])
  @@unique([companyId, cardNumber])
  @@index([companyId, status, updatedAt])
  @@index([companyId, branchId, locationId, status])
}

model CustomerCard {
  id               String             @id @default(uuid())
  companyId        String
  customerId       String
  cardInventoryId  String             @unique
  status           CustomerCardStatus @default(ACTIVE)
  assignedByUserId String?
  assignedAt       DateTime           @default(now())
  unassignedAt     DateTime?
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cardInventory CardInventory @relation(fields: [cardInventoryId], references: [id], onDelete: Cascade)
  assignedBy    User?         @relation("CustomerCardAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, customerId, status, updatedAt])
  @@index([companyId, status, updatedAt])
}

model CustomerPointsLedger {
  id              String                   @id @default(uuid())
  companyId       String
  customerId      String
  cardInventoryId String?
  txnType         CustomerPointsTxnType
  sourceType      CustomerPointsSourceType
  sourceId        String?
  points          Int
  remarks         String?
  metadata        Json?
  createdByUserId String?
  createdAt       DateTime                 @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cardInventory CardInventory? @relation(fields: [cardInventoryId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("CustomerPointsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, customerId, createdAt])
  @@index([companyId, txnType, createdAt])
  @@index([cardInventoryId, createdAt])
}

model CustomerRewardRedemption {
  id               String                 @id @default(uuid())
  companyId        String
  customerId       String
  cardInventoryId  String?
  rewardId         String
  saleId           String?
  status           RewardRedemptionStatus @default(RESERVED)
  pointsSpent      Int
