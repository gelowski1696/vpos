model Sale {
  id                  String     @id @default(uuid())
  companyId           String
  branchId            String
  locationId          String
  shiftId             String?
  userId              String
  customerId          String?
  recreatedFromSaleId String?
  recreatedBySaleId   String?    @unique
  saleType            SaleType
  status              SaleStatus @default(ACTIVE)
  subtotal            Decimal    @db.Decimal(14, 2)
  discountAmount      Decimal    @default(0) @db.Decimal(14, 2)
  totalAmount         Decimal    @db.Decimal(14, 2)
  cogsAmount          Decimal?   @db.Decimal(14, 2)
  receiptHideAmounts  Boolean    @default(false)
  receiptHideReason   String?    @db.Text
  postedAt            DateTime?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  cancelReason        String?    @db.Text
  voidedAt            DateTime?
  voidedByUserId      String?
  voidReason          String?    @db.Text
  createdAt           DateTime   @default(now())

  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch              Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  location            Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shift               Shift?                @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer            Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recreatedFromSale   Sale?                 @relation("SaleRecreatedFrom", fields: [recreatedFromSaleId], references: [id], onDelete: SetNull)
  replacementSale     Sale?                 @relation("SaleRecreatedBy", fields: [recreatedBySaleId], references: [id], onDelete: SetNull)
  recreatedSales      Sale[]                @relation("SaleRecreatedFrom")
  sourceForSales      Sale[]                @relation("SaleRecreatedBy")
  cancelledByUser     User?                 @relation("SaleCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  voidedByUser        User?                 @relation("SaleVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  lines               SaleLine[]
  payments            Payment[]
  customerPayments    CustomerPayment[]
  receipt             Receipt?
  deliveryOrder       DeliveryOrder?
  discountOverride    DiscountOverrideLog[]
  lendingTransactions LendingTransaction[]
  returns             SaleReturn[]
  returnLines         SaleReturnLine[]

  @@index([companyId, status, createdAt])
  @@index([companyId, branchId, status, createdAt])
  @@index([companyId, recreatedFromSaleId])
  @@index([companyId, recreatedBySaleId])
}

