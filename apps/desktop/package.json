{
  "name": "@vpos/desktop",
  "version": "0.1.5",
  "private": true,
  "description": "VPOS Desktop cashier workstation application",
  "author": "VPOS Team",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @vpos/desktop-core build",
    "dev": "vite",
    "prebuild": "pnpm --filter @vpos/desktop-core build",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "pretest": "pnpm --filter @vpos/desktop-core build",
    "test": "jest --config jest.config.cjs",
    "pretypecheck": "pnpm --filter @vpos/desktop-core build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:signed": "tauri build --config src-tauri/tauri.sign.conf.json",
    "tauri:build:ota": "tauri build --bundles msi updater",
    "ota:manifest": "node scripts/create-update-manifest.mjs",
    "version:set": "node scripts/set-desktop-version.mjs",
    "version:check": "node scripts/set-desktop-version.mjs --check",
    "release:check": "pnpm --filter \"@vpos/desktop^...\" build && pnpm version:check && pnpm typecheck && pnpm test --runInBand && pnpm build",
    "docs:update-screens": "node scripts/capture-update-guide.mjs",
    "docs:update-pdf": "node scripts/build-update-guide-pdf.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "1.6.0",
    "@vpos/desktop-core": "workspace:*",
    "@vpos/offline-core": "workspace:*",
    "@vpos/printing-core": "workspace:*",
    "@vpos/shared-types": "workspace:*",
    "@zxing/browser": "^0.1.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sileo": "^0.1.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "1.6.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.19",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.3",
    "vite": "^5.4.19"
  }
}
